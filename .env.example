# Runtime mode. Set to true only for local development; production refuses it.
YGF_DEMO_MODE=

# Canonical HTTPS application origin used for callbacks and same-origin checks.
NEXT_PUBLIC_APP_URL=
YGF_PUBLIC_ORIGIN=

# Supabase project configuration. The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-only secrets. Generate independent random values of at least 32 bytes.
YGF_CLAIM_COOKIE_SECRET=
YGF_ABUSE_SIGNAL_SECRET=
YGF_TASK_FINGERPRINT_SECRET=

# OpenRouter-compatible inference configuration. API keys are server-only.
YGF_PROVIDER_API_KEY=
YGF_PROVIDER_BASE_URL=

# Optional fallback name recognized for an OpenRouter server key.
OPENROUTER_API_KEY=

# Optional comma-separated exact admin email allowlist.
YGF_ADMIN_EMAIL_ALLOWLIST=
