# Runtime mode. Set to true only for local development; production refuses it.
YGF_DEMO_MODE=
# Optional local-only browser-task switch: deterministic (default) or openai.
# It does not enable the Agent gateway. OpenAI requires the server-only key.
YGF_DEMO_PROVIDER=

# Canonical HTTPS application origin used for callbacks and same-origin checks.
NEXT_PUBLIC_APP_URL=
YGF_PUBLIC_ORIGIN=

# Supabase project configuration. The secret key is server-only.
# Anonymous sign-in, manual identity linking, CAPTCHA/Turnstile, and cleanup
# are Supabase dashboard/operations gates; no env value here enables them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-only secrets. Generate independent random values of at least 32 bytes.
# The task and Agent request fingerprint secrets are mandatory in every mode,
# including the local demo; they never use development fallback values.
YGF_CLAIM_COOKIE_SECRET=
YGF_ABUSE_SIGNAL_SECRET=
YGF_TASK_FINGERPRINT_SECRET=
YGF_AGENT_API_KEY_DIGEST_SECRET=
YGF_AGENT_REQUEST_FINGERPRINT_SECRET=

# Direct OpenAI inference credential. Server-only; never expose in NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Production Agent gateway remains disabled unless explicitly enabled.
YGF_AGENT_GATEWAY_ENABLED=false
# Integer micro-US dollars represented by one Agent credit. Default: 1,000.
YGF_AGENT_MICRO_USD_PER_CREDIT=1000

# Optional comma-separated exact admin email allowlist.
YGF_ADMIN_EMAIL_ALLOWLIST=
